# What CoreELEC 22.0 (samurihl 20260928) provides; refresh after a CoreELEC update.
# Newest symbol versions in its libc, libstdc++ and libgcc_s:
GLIBC=2.44
GLIBCXX=3.4.36
CXXABI=1.3.17
GCC=16.0
# Its system and graphics libraries, which nothing here bundles:
LIBRARIES=^(?:ld-linux.*|lib(?:c|m|mvec|dl|pthread|rt|resolv|util|anl|nss_.*|gcc_s|stdc\+\+|atomic|drm.*|udev|wayland-.*|EGL|GLES.*|GL.*|gbm)\.so(?:\..*)?)$
