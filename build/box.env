# Library contract for CoreELEC 22; refresh when the target changes.
# Maximum symbol versions supplied by libc, libstdc++ and libgcc_s:
GLIBC=2.44
GLIBCXX=3.4.36
CXXABI=1.3.17
GCC=16.0
# System and graphics libraries supplied by CoreELEC, excluded from the add-on:
LIBRARIES=^(?:ld-linux.*|lib(?:c|m|mvec|dl|pthread|rt|resolv|util|anl|nss_.*|gcc_s|stdc\+\+|atomic|drm.*|udev|wayland-.*|EGL|GLES.*|GL.*|gbm)\.so(?:\..*)?)$
