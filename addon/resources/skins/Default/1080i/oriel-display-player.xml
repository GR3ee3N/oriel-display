<?xml version="1.0" encoding="UTF-8"?>
<!-- Overlay the page on Kodi fullscreen video. -->
<window>
  <controls>
    <!-- A transparent Kodi image triggers HDR GUI composition. Kodi requires
         a draw from its own controls to composite the GUI; the renderaddon
         page draw alone does not trigger it. -->
    <control type="image">
      <left>0</left><top>0</top><width>1</width><height>1</height>
      <texture colordiffuse="00FFFFFF">$INFO[Window.Property(white)]</texture>
    </control>
    <control type="renderaddon" id="10">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
    </control>
  </controls>
</window>
